# workflow/Snakefile

import numpy as np

n_rep = 10

np.random.seed(3821)
seed_list = np.random.randint(1, 2**31, n_rep)

rule all:
    input:
        expand(
            "results/simulation/rep_{rep}/simulation.rep_{rep}.vcf",
            rep=range(n_rep),
        ),
        expand(
            "results/sstar/rep_{rep}/sstar.phased.rep_{rep}.scores.tsv",
            rep=range(n_rep),
        ),
        expand(
            "results/sstar/rep_{rep}/sstar.phased.rep_{rep}.quantile.tsv",
            rep=range(n_rep),
        )

include: "rules/simulation.smk"
include: "rules/sstar.smk"
include: "rules/quantile_regression.smk"
